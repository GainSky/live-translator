{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveTranslator",
  "version": "0.1.0",
  "identifier": "dev.live-translator.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LiveTranslator",
        "url": "index.html",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "overlay",
        "title": "LiveTranslator Overlay",
        "url": "overlay.html",
        "width": 760,
        "height": 140,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": ["icons/icon.png"]
  }
}
